{
  "name": "clearshift-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ClearShift CRM — monorepo root",
  "workspaces": [
    "apps/*",
    "apps/crm/modules/*",
    "packages/*"
  ],
  "scripts": {
    "db:migrate": "node infra/scripts/db-migrate.ts",
    "db:migrate:test": "cross-env NODE_ENV=test node infra/scripts/db-migrate.ts",
    "db:seed": "node infra/scripts/seed.ts",
    "db:seed:test": "cross-env NODE_ENV=test node infra/scripts/seed.ts",
    "db:wait": "node infra/scripts/db-migrate.ts --wait-only",
    "db:reset": "node scripts/db-reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "validate:frontend": "node scripts/validate-frontend.js",
    "security:audit": "./infra/security/dependency-audit.sh",
    "security:secrets": "./infra/security/secret-scan.sh",
    "security:repo": "./infra/security/repo-audit.sh",
    "security:check": "./infra/security/dependency-audit.sh && ./infra/security/secret-scan.sh && ./infra/security/repo-audit.sh",
    "governance:verify": "./infra/governance/verify-pmo12.sh"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "@types/react": "19.2.18",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitest/coverage-v8": "4.1.12",
    "cross-env": "7.0.3",
    "drizzle-orm": "0.45.2",
    "eslint": "9.39.5",
    "react": "19.2.8",
    "typescript": "5.7.3",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  },
  "overrides": {
    "tinypool": "2.2.0",
    "vite": "6.4.4",
    "esbuild": "0.28.2",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
