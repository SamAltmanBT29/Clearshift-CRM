{
  "extends": "../../../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react",
    "composite": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "**/*",
    "../../../../../packages/*/src/**/*"
  ]
}
